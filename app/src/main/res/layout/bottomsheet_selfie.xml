<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    app:shapeAppearanceOverlay="@style/TopRoundCard"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Drag handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:background="@drawable/bottomsheet_handle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Click Meeting Photo"
            android:textStyle="bold"
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/dragHandle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Info -->
        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Align your face inside the circle"
            android:textSize="13sp"
         android:fontFamily="@font/poppins_semibold"
            android:layout_marginTop="4dp"

            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#000"
            app:implementationMode="performance"
            app:layout_constraintTop_toBottomOf="@id/txtInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="3:3"
            android:layout_marginTop="12dp"/>

        <!-- Face Guide -->
        <ImageView
            android:id="@+id/faceGuide"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:src="@drawable/face_circle_guide"
            android:alpha="0.7"
            app:layout_constraintTop_toTopOf="@id/cameraPreview"
            app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="@id/cameraPreview"
            app:layout_constraintEnd_toEndOf="@id/cameraPreview"/>

        <!-- Preview after capture -->
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:layout_marginTop="10dp"
            app:layout_constraintDimensionRatio="3:3"
            app:layout_constraintTop_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Buttons Layout -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/imgPreview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Capture Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_40dp"
                android:text="Capture"
                android:textColor="@color/white"
                android:background="@drawable/round_cornor_bg"
                android:backgroundTint="@color/vil_blue"
                android:textSize="@dimen/size_16sp"
                android:fontFamily="@font/poppins_semibold"/>

            <!-- Retry Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_40dp"
                android:text="Retry"
                android:visibility="gone"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/round_cornor_bg"
                android:textColor="@color/white"
                android:textSize="@dimen/size_16sp"
                android:backgroundTint="@color/vil_red"
                android:fontFamily="@font/poppins_semibold"/>

            <!-- Done Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_40dp"
                android:text="Done"
                android:visibility="gone"
                android:layout_weight="1"
                android:background="@drawable/round_cornor_bg"
                android:textColor="@color/white"
                android:textSize="@dimen/size_16sp"
                android:backgroundTint="@color/vil_blue"
                android:fontFamily="@font/poppins_semibold"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>